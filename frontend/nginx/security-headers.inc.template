# Security headers for the web client's HTML and static assets (API responses carry
# their own headers from the backend). Rendered with envsubst to
# /etc/nginx/conf.d/security-headers.inc (not *.conf, so it is not loaded globally) and
# included in every static `location`, because nginx does not inherit `add_header`
# into locations that declare their own.
#
# CSP: scripts only from this origin (no inline scripts — see public/theme-init.js).
# Inline style *attributes* are needed by the UI libraries. Images may come from the
# object store (avatars/attachments via presigned URLs): set CSP_IMG_SRC to its origin.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_IMG_SRC}; font-src 'self' data:; connect-src 'self' ${CSP_CONNECT_SRC}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self' blob:" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
# HSTS belongs on the TLS-terminating proxy / load balancer in front of this container.
