# FlowSync web client — nginx server (rendered with envsubst at container start).
#
#   API_UPSTREAM      Backend base URL, e.g. http://backend:4000 (API + WebSocket)
#   CSP_IMG_SRC       Extra image origins, e.g. the object store: https://files.example.com
#   CSP_CONNECT_SRC   Extra fetch/WebSocket origins (only if the API lives on another origin)
#
# nginx's own variables ($host, $uri, …) are left alone by envsubst.

# Edge rate limits per client address (the API applies finer per-user limits behind them).
limit_req_zone $binary_remote_addr zone=flowsync_api:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=flowsync_conn:10m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Attachments are limited to 25 MB by the API; leave room for multipart overhead.
    client_max_body_size 30m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    limit_req_status 429;
    limit_conn_status 429;

    # --- Container health ------------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- API (REST) ------------------------------------------------------------------
    location /api/ {
        limit_req zone=flowsync_api burst=200 nodelay;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The API trusts one proxy hop (TRUST_PROXY=1) and takes the address nginx appends.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_request_buffering off;
    }

    # --- Real-time (WebSocket) -------------------------------------------------------------
    location = /ws {
        limit_conn flowsync_conn 20;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The server pings every 30 s; idle sockets are closed well after that.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # --- Static assets: content-hashed, cache forever ---------------------------------------
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Never serve source maps (they are stripped from the image anyway).
    location ~* \.map$ {
        return 404;
    }

    # --- SPA: unknown paths render index.html; the HTML itself is never cached ------------
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
