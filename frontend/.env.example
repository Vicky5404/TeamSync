# ---------------------------------------------------------------------------
# FlowSync web client — environment variables
# Copy to `.env.local` (or `.env.development.local`) and adjust; both are
# git-ignored. Only VITE_-prefixed variables are exposed to the browser bundle,
# so NEVER put secrets in VITE_ variables. The web client needs no secrets:
# JWT, database, Redis, S3 and SMTP credentials live only in backend/.env.
# ---------------------------------------------------------------------------

# Display name used in the UI and document titles.
VITE_APP_NAME=FlowSync

# Base URL of the REST API. Can be absolute (https://api.example.com/api/v1)
# or relative (/api/v1) when served behind the same origin / dev proxy.
VITE_API_BASE_URL=/api/v1

# Request timeout for API calls, in milliseconds (uploads have no timeout).
VITE_API_TIMEOUT_MS=15000

# WebSocket endpoint for real-time events. Absolute (wss://api.example.com/ws)
# or a same-origin path (/ws → ws:// on http pages, wss:// on https pages).
# Leave empty to disable real-time; the app then polls for notifications.
VITE_WS_URL=/ws

# Maximum attachment size checked before uploading. Keep in sync with the API's
# UPLOAD_MAX_FILE_SIZE_MB (the API remains the authority).
VITE_UPLOAD_MAX_FILE_SIZE_MB=25

# Dev server only (not exposed to the browser): proxy /api and /ws to a
# locally running backend.
DEV_API_PROXY_TARGET=http://localhost:4000
