# Defaults for `npm run dev`. Override locally in `.env.development.local` (git-ignored).
# The dev server proxies /api and /ws to the backend, so cookies, CORS and the
# WebSocket origin check all stay same-origin (http://localhost:5173).
VITE_APP_NAME=FlowSync
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=15000
VITE_WS_URL=/ws
VITE_UPLOAD_MAX_FILE_SIZE_MB=25
DEV_API_PROXY_TARGET=http://localhost:4000
