# Defaults for `npm run build`. Override per environment in CI/CD.
# Relative URLs assume the API (/api/v1) and WebSocket (/ws) are served from the
# same origin as the web client, e.g. behind one reverse proxy.
VITE_APP_NAME=FlowSync
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=15000
VITE_WS_URL=/ws
VITE_UPLOAD_MAX_FILE_SIZE_MB=25
