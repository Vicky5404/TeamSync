# ---------------------------------------------------------------------------
# FlowSync API — environment variables
# Copy to `.env` to run the API from source (`npm run start:dev`) against the
# infrastructure started by the root docker-compose.yml (`docker compose up -d postgres redis s3 mailpit`).
# Everything is validated at startup (src/config/env.validation.ts); invalid or
# unsafe production configuration aborts the process with a clear error.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Route prefix: endpoints live under /api/v1 (health checks stay at /health).
API_PREFIX=api/v1
# Web client origin, used to build links in emails.
APP_URL=http://localhost:5173
# How browsers reach this API (used for avatar URLs). Relative works behind the Vite proxy.
PUBLIC_API_URL=/api/v1
# Comma-separated browser origins allowed by CORS and the WebSocket origin check.
CORS_ORIGINS=http://localhost:5173
# Express "trust proxy": false | true | <hop count> | <subnet list>. Set when behind a load balancer.
TRUST_PROXY=false
LOG_LEVEL=info
# Human-readable logs (development only; production should emit JSON).
LOG_PRETTY=true
# Swagger UI at /api/v1/docs. Defaults to on, except with NODE_ENV=production (opt in explicitly).
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
# Run BullMQ workers inside the API process. Convenient locally; in production run
# `npm run start:worker:prod` as a separate process and set this to false.
RUN_WORKERS_IN_API=true
# Health endpoint of the dedicated worker process (GET /health, /health/live); 0 disables it.
WORKER_HEALTH_PORT=4001

# --- PostgreSQL ---------------------------------------------------------------
DATABASE_URL=postgresql://flowsync:flowsync@localhost:5432/flowsync?schema=public
DATABASE_POOL_SIZE=10
# Optional: shadow database for `prisma migrate dev` (created automatically if omitted).
SHADOW_DATABASE_URL=

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=flowsync:

# --- Authentication -----------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
# Access-token lifetime in seconds.
JWT_ACCESS_TTL=900
JWT_ISSUER=flowsync-api
JWT_AUDIENCE=flowsync-web
# Refresh-token lifetime with / without "keep me signed in" (sliding).
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_SHORT_TTL_HOURS=24
REFRESH_COOKIE_NAME=flowsync_rt
# Must be true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AUTH_REQUIRE_EMAIL_VERIFICATION=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Rate limiting (per user when signed in, otherwise per IP) ----------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# --- Object storage (S3 or compatible; MinIO locally) -------------------------
S3_BUCKET=flowsync
S3_REGION=us-east-1
# Leave empty for AWS S3.
S3_ENDPOINT=http://localhost:9000
# Endpoint browsers use for presigned URLs, if different from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=flowsync
S3_SECRET_ACCESS_KEY=flowsync-secret
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_FILE_SIZE_MB=25
AVATAR_MAX_FILE_SIZE_MB=5
SIGNED_URL_TTL_SECONDS=900

# --- Email --------------------------------------------------------------------
# `smtp` sends through SMTP (Mailpit locally: http://localhost:8025); `log` only logs.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FlowSync <no-reply@flowsync.dev>"
