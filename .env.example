# Optional overrides for `docker compose` (copy to `.env` in this directory; never commit it).
# Application settings live in docker-compose.yml (containers) and backend/.env (running from source).

# Host ports
WEB_PORT=8080
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=9000
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Signing secret for access tokens (>= 32 random characters), e.g. `openssl rand -base64 48`.
# The default in docker-compose.yml is for local development only.
# JWT_ACCESS_SECRET=
